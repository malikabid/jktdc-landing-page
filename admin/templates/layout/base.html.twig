<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DOTK Admin{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/admin/css/admin.css">
    {% block styles %}{% endblock %}
</head>
<body>
    <nav class="navbar">
        <div class="navbar-content">
            <a href="/admin/dashboard" class="navbar-brand">
                <i class="fas fa-shield-alt"></i>
                <span>DOTK Admin</span>
            </a>
            <div class="navbar-user">
                <div class="user-info">
                    <div class="user-name" id="userName">Loading...</div>
                    <div class="user-role" id="userRole"></div>
                </div>
                <button class="btn-logout" onclick="logout()">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
        </div>
    </nav>
    
    <main class="main-content">
        {% block content %}{% endblock %}
    </main>
    
    <footer class="admin-footer">
        <div class="footer-content">
            <div class="footer-copyright">
                © {{ "now"|date("Y") }} <a href="https://kashmirtourismofficial.com" target="_blank">Directorate of Tourism Kashmir</a>, Government of J&K. All Rights Reserved.
            </div>
            <div class="footer-version">
                <span>Admin Panel</span>
                <span class="version-badge">v{{ app_version }}</span>
            </div>
        </div>
    </footer>
    
    <div class="toast-container">
        <div id="toast" class="toast">
            <div class="toast-header">
                <i class="fas fa-info-circle" id="toastIcon"></i>
                <strong id="toastTitle">Notification</strong>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    <!-- Persistent error dialog. Unlike the toast it never auto-dismisses, so a
         failure reason stays on screen until the user closes it. -->
    <style>
        .error-modal {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .error-modal[hidden] { display: none; }
        .error-modal__backdrop {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
        }
        .error-modal__panel {
            position: relative;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            max-width: 560px;
            width: 100%;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .error-modal__header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px 22px;
            background: #fee2e2;
            color: #991b1b;
        }
        .error-modal__header i { font-size: 1.4rem; }
        .error-modal__header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; }
        .error-modal__body {
            padding: 20px 22px;
            color: #1e293b;
            line-height: 1.55;
            overflow-y: auto;
            white-space: pre-line;
            word-break: break-word;
        }
        .error-modal__body ul { margin: 8px 0 0; padding-left: 20px; }
        .error-modal__body li { margin-bottom: 6px; }
        .error-modal__actions {
            padding: 14px 22px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
        .error-modal__close {
            padding: 10px 22px;
            border: none;
            border-radius: 8px;
            background: #9333ea;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }
        .error-modal__close:hover { background: #7e22ce; }
    </style>
    <div class="error-modal" id="errorModal" hidden>
        <div class="error-modal__backdrop" data-error-close></div>
        <div class="error-modal__panel" role="alertdialog" aria-modal="true"
             aria-labelledby="errorModalTitle" aria-describedby="errorModalBody">
            <div class="error-modal__header">
                <i class="fas fa-exclamation-circle"></i>
                <h3 id="errorModalTitle">Error</h3>
            </div>
            <div class="error-modal__body" id="errorModalBody"></div>
            <div class="error-modal__actions">
                <button type="button" class="error-modal__close" data-error-close>Close</button>
            </div>
        </div>
    </div>


    <script>
        const token = localStorage.getItem('dotk_admin_token');
        if (!token) window.location.href = '/admin/';
        
        function getToken() { return localStorage.getItem('dotk_admin_token'); }
        
        loadUserInfo();
        
        async function loadUserInfo() {
            try {
                const response = await fetch('/admin/api/auth/me', {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                if (response.status === 401) {
                    localStorage.removeItem('dotk_admin_token');
                    window.location.href = '/admin/';
                    return;
                }
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('userName').textContent = data.user.full_name;
                    document.getElementById('userRole').textContent = data.user.role.replace('_', ' ');
                }
            } catch (error) {
                console.error('Error loading user info:', error);
            }
        }
        
        function showToast(title, message, type = 'info') {
            const toast = document.getElementById('toast');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMessage').textContent = message;
            
            toast.classList.remove('success', 'error', 'warning', 'info');
            toast.classList.add(type);
            
            const icon = document.getElementById('toastIcon');
            switch(type) {
                case 'success': icon.className = 'fas fa-check-circle'; break;
                case 'error': icon.className = 'fas fa-exclamation-circle'; break;
                case 'warning': icon.className = 'fas fa-exclamation-triangle'; break;
                default: icon.className = 'fas fa-info-circle';
            }
            
            toast.classList.add('show');
            setTimeout(() => { toast.classList.remove('show'); }, 5000);
        }
        
        // Parse a JSON response without throwing when the body is not clean JSON.
        // PHP notices emitted before the payload (e.g. a request over post_max_size)
        // would otherwise make response.json() throw and hide the real error.
        async function readJsonSafely(response) {
            const text = await response.text();
            try {
                return JSON.parse(text);
            } catch (e) {
                const start = text.indexOf('{');
                const end = text.lastIndexOf('}');
                if (start !== -1 && end > start) {
                    try {
                        return JSON.parse(text.slice(start, end + 1));
                    } catch (e2) { /* fall through */ }
                }
                return { error: text.trim().slice(0, 300) || `Unexpected response (HTTP ${response.status})` };
            }
        }

        // Persistent error dialog. Stays until the user closes it - use this for
        // failures the user must actually read and act on, rather than showToast,
        // which disappears after 5 seconds.
        // `message` may be a string or an array of strings (rendered as a list).
        function showError(title, message) {
            const modal = document.getElementById('errorModal');
            const body = document.getElementById('errorModalBody');

            document.getElementById('errorModalTitle').textContent = title || 'Error';

            if (Array.isArray(message)) {
                const list = document.createElement('ul');
                message.forEach(item => {
                    const li = document.createElement('li');
                    li.textContent = item;
                    list.appendChild(li);
                });
                body.replaceChildren(list);
            } else {
                body.textContent = message || 'Something went wrong.';
            }

            modal.hidden = false;
            modal.querySelector('.error-modal__close').focus();
        }

        function hideError() {
            document.getElementById('errorModal').hidden = true;
        }

        document.getElementById('errorModal').addEventListener('click', function (e) {
            if (e.target.hasAttribute('data-error-close')) hideError();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !document.getElementById('errorModal').hidden) hideError();
        });

        function logout() {
            localStorage.removeItem('dotk_admin_token');
            window.location.href = '/admin/';
        }
    </script>
    
    {% block scripts %}{% endblock %}
</body>
</html>
