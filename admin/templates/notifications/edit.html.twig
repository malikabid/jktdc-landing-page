{% extends 'layout/base.html.twig' %}

{% block title %}Edit Notification - DOTK Admin{% endblock %}

{% block styles %}
<style>
    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 34px;
    }

    .checkbox-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .checkbox-group label {
        cursor: pointer;
        color: #374151;
    }

    .icon-input {
        max-width: 90px;
        text-align: center;
        font-size: 1.3rem;
    }
</style>
{% endblock %}

{% block content %}
<div class="container">
    <div class="page-header">
        <h1><i class="fas fa-edit"></i> Edit Notification</h1>
        <a href="/admin/notifications" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="form-card">
        <div id="loadingContainer" class="loading-container">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Loading notification details...</p>
        </div>

        <form id="notificationForm" style="display: none;">
            <input type="hidden" id="notificationId" value="{{ notificationId }}">

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Title <span class="required">*</span></label>
                    <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Notification Number</label>
                    <input type="text" class="form-control" id="notification_number" name="notification_number" placeholder="e.g., Est/407-A/DTK/14">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label class="form-label">Description <span class="required">*</span></label>
                    <textarea class="form-control" id="description" name="description" rows="4" required></textarea>
                    <p class="help-text">This is the text shown in the ticker and on the notifications page.</p>
                </div>
            </div>

            <div class="form-row four-cols">
                <div class="form-group">
                    <label class="form-label">Category <span class="required">*</span></label>
                    <select class="form-control" id="category" name="category" required>
                        <option value="">Select Category</option>
                        {% for category in categories %}
                        <option value="{{ category }}">{{ category }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Priority <span class="required">*</span></label>
                    <select class="form-control" id="priority" name="priority" required>
                        {% for priority in priorities %}
                        <option value="{{ priority }}">{{ priority|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Publish Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="publish_date" name="publish_date" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Expiry Date</label>
                    <input type="date" class="form-control" id="expiry_date" name="expiry_date">
                </div>
            </div>

            <div class="form-row four-cols">
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="status" name="status">
                        <option value="draft">Draft</option>
                        <option value="published">Published</option>
                        <option value="archived">Archived</option>
                    </select>
                    <p class="help-text">Only published notifications inside their date window appear on the public site.</p>
                </div>
                <div class="form-group">
                    <label class="form-label">Icon</label>
                    <input type="text" class="form-control icon-input" id="icon" name="icon" maxlength="4">
                    <p class="help-text">Emoji shown beside the notification.</p>
                </div>
                <div class="form-group checkbox-group">
                    <input type="checkbox" id="show_arrow" name="show_arrow">
                    <label for="show_arrow">Show pointing arrow</label>
                </div>
            </div>

            <!-- Existing Documents Section -->
            <div class="existing-docs-section" id="existingDocsSection" style="display: none;">
                <h3><i class="fas fa-paperclip"></i> Existing Documents</h3>
                <div id="existingDocsList"></div>
            </div>

            <div class="documents-section">
                <h3><i class="fas fa-file-alt"></i> Add New Documents</h3>
                <p class="help-text">Add up to 5 documents total. Supported formats: PDF, DOC, DOCX. Max size: 10MB each. The first document becomes the download link on the public page.</p>

                <div id="documentsContainer">
                    <div class="document-row" data-row="1">
                        <div class="form-group">
                            <label class="form-label">Document Label</label>
                            <input type="text" class="form-control doc-label" placeholder="e.g., DPC Meeting Notice">
                        </div>
                        <div class="form-group">
                            <label class="form-label">File</label>
                            <input type="file" class="form-control doc-file" accept=".pdf,.doc,.docx">
                        </div>
                        <button type="button" class="btn-remove-doc" style="display: none;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>

                <button type="button" id="addDocumentBtn" class="btn-add-doc">
                    <i class="fas fa-plus"></i> Add Another Document
                </button>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary" id="submitBtn">
                    <i class="fas fa-save"></i> Update Notification
                </button>
                <a href="/admin/notifications" class="btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const notificationId = document.getElementById('notificationId').value;
    // Single source of truth for the advertised attachment limit (see help text)
    const MAX_UPLOAD_MB = 10;
    let documentRowCount = 1;
    let existingDocsCount = 0;
    const maxDocuments = 5;

    loadNotificationData();

    async function loadNotificationData() {
        try {
            const response = await fetch(`/admin/api/notifications/${notificationId}`, {
                headers: { 'Authorization': `Bearer ${getToken()}` }
            });

            if (response.status === 401) {
                localStorage.removeItem('dotk_admin_token');
                window.location.href = '/admin/';
                return;
            }

            if (!response.ok) {
                showError('Could not load notification', 'Failed to load the notification details. Reload the page to try again.');
                return;
            }

            const result = await response.json();
            const notification = result.notification || result;

            document.getElementById('title').value = notification.title || '';
            document.getElementById('notification_number').value = notification.notification_number || '';
            document.getElementById('description').value = notification.description || '';
            document.getElementById('category').value = notification.category || '';
            document.getElementById('priority').value = notification.priority || 'medium';
            document.getElementById('publish_date').value = notification.publish_date ? notification.publish_date.split('T')[0] : '';
            document.getElementById('expiry_date').value = notification.expiry_date ? notification.expiry_date.split('T')[0] : '';
            document.getElementById('status').value = notification.status || 'draft';
            document.getElementById('icon').value = notification.icon || '📄';
            document.getElementById('show_arrow').checked = !!notification.show_arrow;

            // Load existing documents
            if (notification.documents && notification.documents.length > 0) {
                existingDocsCount = notification.documents.length;
                const existingDocsSection = document.getElementById('existingDocsSection');
                const existingDocsList = document.getElementById('existingDocsList');
                existingDocsSection.style.display = 'block';

                existingDocsList.innerHTML = notification.documents.map(doc => `
                    <div class="existing-doc-item" data-doc-id="${doc.id}">
                        <div class="doc-info">
                            <i class="fas fa-file-pdf"></i>
                            <a href="${doc.file_path}" target="_blank">${doc.name}</a>
                        </div>
                        <button type="button" class="btn-delete-doc" onclick="deleteDocument(${doc.id}, this)">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                `).join('');
            }

            document.getElementById('loadingContainer').style.display = 'none';
            document.getElementById('notificationForm').style.display = 'block';

        } catch (error) {
            console.error('Error:', error);
            showError('Network error', 'Could not reach the server while loading this notification. Check your connection and reload the page.');
        }
    }

    async function deleteDocument(docId, btn) {
        if (!confirm('Are you sure you want to delete this document?')) return;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch(`/admin/api/notifications/${notificationId}/documents/${docId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${getToken()}` }
            });

            if (response.status === 401) {
                localStorage.removeItem('dotk_admin_token');
                window.location.href = '/admin/';
                return;
            }

            const result = await response.json();

            if (result.success) {
                btn.closest('.existing-doc-item').remove();
                existingDocsCount--;

                if (existingDocsCount === 0) {
                    document.getElementById('existingDocsSection').style.display = 'none';
                }

                showToast('Success', 'Document deleted successfully', 'success');
            } else {
                showError('Could not delete document', result.error || 'The document could not be deleted.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-trash"></i> Delete';
            }
        } catch (error) {
            console.error('Error:', error);
            showError('Network error', 'Could not reach the server while deleting the document. Please try again.');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-trash"></i> Delete';
        }
    }

    document.getElementById('addDocumentBtn').addEventListener('click', function() {
        const totalDocs = existingDocsCount + documentRowCount;
        if (totalDocs >= maxDocuments) {
            showToast('Maximum Documents', 'You can only have up to 5 documents total.', 'warning');
            return;
        }
        documentRowCount++;
        const container = document.getElementById('documentsContainer');
        const newRow = document.createElement('div');
        newRow.className = 'document-row';
        newRow.dataset.row = documentRowCount;
        newRow.innerHTML = `
            <div class="form-group">
                <label class="form-label">Document Label</label>
                <input type="text" class="form-control doc-label" placeholder="e.g., Annexure">
            </div>
            <div class="form-group">
                <label class="form-label">File</label>
                <input type="file" class="form-control doc-file" accept=".pdf,.doc,.docx">
            </div>
            <button type="button" class="btn-remove-doc"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(newRow);
        updateRemoveButtons();
    });

    document.getElementById('documentsContainer').addEventListener('click', function(e) {
        if (e.target.closest('.btn-remove-doc')) {
            e.target.closest('.document-row').remove();
            documentRowCount--;
            updateRemoveButtons();
        }
    });

    function updateRemoveButtons() {
        const rows = document.querySelectorAll('.document-row');
        rows.forEach((row) => {
            const btn = row.querySelector('.btn-remove-doc');
            btn.style.display = rows.length > 1 ? 'block' : 'none';
        });
    }

    document.getElementById('notificationForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

        const currentToken = getToken();
        if (!currentToken) {
            showError('Session expired', 'Your session has expired. Please log in again.');
            setTimeout(() => { window.location.href = '/admin/'; }, 1500);
            return;
        }

        const publishDate = document.getElementById('publish_date').value;
        const expiryDate = document.getElementById('expiry_date').value;

        if (expiryDate && expiryDate < publishDate) {
            showError('Invalid dates', 'The expiry date cannot be before the publish date.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Update Notification';
            return;
        }

        const fileInputs = document.querySelectorAll('.doc-file');
        let hasValidationError = false;

        for (const input of fileInputs) {
            if (input.files.length > 0) {
                const file = input.files[0];
                const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
                const maxSize = MAX_UPLOAD_MB * 1024 * 1024;

                if (!allowedTypes.includes(file.type)) {
                    showError('Invalid file type', `"${file.name}" is not an accepted file type. Only PDF, DOC and DOCX files can be attached.`);
                    hasValidationError = true;
                    break;
                }
                if (file.size > maxSize) {
                    showError('File too large', `"${file.name}" is ${(file.size/1024/1024).toFixed(1)} MB. The maximum attachment size is ${MAX_UPLOAD_MB} MB.`);
                    hasValidationError = true;
                    break;
                }
            }
        }

        if (hasValidationError) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Update Notification';
            return;
        }

        const notificationData = {
            title: document.getElementById('title').value,
            notification_number: document.getElementById('notification_number').value,
            description: document.getElementById('description').value,
            category: document.getElementById('category').value,
            priority: document.getElementById('priority').value,
            publish_date: publishDate,
            expiry_date: expiryDate,
            status: document.getElementById('status').value,
            icon: document.getElementById('icon').value,
            show_arrow: document.getElementById('show_arrow').checked
        };

        try {
            const response = await fetch(`/admin/api/notifications/${notificationId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + currentToken
                },
                body: JSON.stringify(notificationData)
            });

            if (response.status === 401) {
                showError('Session expired', 'Your session has expired. Please log in again.');
                localStorage.removeItem('dotk_admin_token');
                setTimeout(() => { window.location.href = '/admin/'; }, 1500);
                return;
            }

            const result = await response.json();

            if (result.success) {
                const documentRows = document.querySelectorAll('.document-row');
                let uploadErrors = [];

                for (const row of documentRows) {
                    const labelInput = row.querySelector('.doc-label');
                    const fileInput = row.querySelector('.doc-file');

                    // A file with no label used to be skipped silently, which looked
                    // exactly like a failed upload. Fall back to the filename.
                    if (fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        const label = labelInput.value.trim() || file.name;

                        const formData = new FormData();
                        formData.append('label', label);
                        formData.append('document', file);

                        try {
                            const uploadResponse = await fetch(`/admin/api/notifications/${notificationId}/documents`, {
                                method: 'POST',
                                headers: { 'Authorization': 'Bearer ' + getToken() },
                                body: formData
                            });

                            if (uploadResponse.status === 401) {
                                showError('Session Expired', 'Your session has expired. Please log in again.');
                                localStorage.removeItem('dotk_admin_token');
                                return;
                            }

                            const uploadResult = await readJsonSafely(uploadResponse);
                            if (!uploadResponse.ok || !uploadResult.success) {
                                uploadErrors.push(`${label} — ${uploadResult.error || uploadResult.message || `upload failed (HTTP ${uploadResponse.status})`}`);
                            }
                        } catch (err) {
                            uploadErrors.push(`${label} — ${err.message}`);
                        }
                    }
                }

                if (uploadErrors.length > 0) {
                    // Stay on the page so the reason is readable and the files can be retried
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-save"></i> Update Notification';
                    showError(
                        uploadErrors.length === 1 ? 'Document upload failed' : 'Some documents failed to upload',
                        ['The notification itself was saved. These attachments did not upload:', ...uploadErrors]
                    );
                    return;
                }

                showToast('Success', 'Notification updated successfully!', 'success');
                setTimeout(() => { window.location.href = '/admin/notifications'; }, 1500);
            } else {
                showError('Could not save notification', result.error || result.message || 'The notification could not be updated.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save"></i> Update Notification';
            }
        } catch (error) {
            console.error('Error:', error);
            showError('Network error', 'Could not reach the server. Your changes were not saved. Please try again.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Update Notification';
        }
    });
</script>
{% endblock %}
